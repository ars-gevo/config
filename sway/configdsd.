set $mod Mod4
set $left h
set $down j
set $up k
set $right l

font pango: JetBrains Mono Nerd Font 12
output * bg ~/.config/sway/mountain.jpg fill
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
client.focused    #ffffff #ffffff #000000 #ffffff #ffffff
client.unfocused  #b0b0b0 #b0b0b0 #888888 #b0b0b0 #b0b0b0

exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 2100 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'

input type:touchpad {
    dwt disabled
    tap enabled
    natural_scroll disabled
    middle_emulation enabled
}

input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:caps_toggle,caps:shiftlock"
}

bindsym --to-code Escape mode "normal"
mode "normal" {
    bindsym --to-code q exec foot
    bindsym --to-code c kill
    bindsym --to-code Shift+r reload
    bindsym --to-code Shift+e exit 
    bindsym --to-code Shift+f exec firefox
    bindsym --to-code Shift+v exec throne
    bindsym --to-code Shift+s exec steam
    bindsym --to-code Shift+c exec idle
    bindsym --to-code Shift+q exec qutebrowser

bindsym --to-code a focus parent
bindsym --to-code h focus left
bindsym --to-code j focus down
bindsym --to-code k focus up
bindsym --to-code l focus right

bindsym --to-code Shift+h move left
bindsym --to-code Shift+j move down
bindsym --to-code Shift+k move up
bindsym --to-code Shift+l move right

bindsym 1 workspace number 1
bindsym 2 workspace number 2
bindsym 3 workspace number 3
bindsym 4 workspace number 4
bindsym 5 workspace number 5
bindsym 6 workspace number 6
bindsym 7 workspace number 7
bindsym 8 workspace number 8
bindsym 9 workspace number 9
bindsym 0 workspace number 10

bindsym Shift+1 move container to workspace number 1
bindsym Shift+2 move container to workspace number 2
bindsym Shift+3 move container to workspace number 3
bindsym Shift+4 move container to workspace number 4
bindsym Shift+5 move container to workspace number 5
bindsym Shift+6 move container to workspace number 6
bindsym Shift+7 move container to workspace number 7
bindsym Shift+8 move container to workspace number 8
bindsym Shift+9 move container to workspace number 9
bindsym Shift+0 move container to workspace number 10

bindsym --to-code b splith
bindsym --to-code v splitv

bindsym --to-code s layout stacking
bindsym --to-code w layout tabbed
bindsym --to-code e layout toggle split

bindsym --to-code f fullscreen

floating_modifier $mod normal
bindsym Shift+space floating toggle
bindsym space focus mode_toggle

bindsym Shift+minus move scratchpad
bindsym minus scratchpad show


    bindsym i mode "default"
}

bindsym --to-code $mod+r mode "resize"
mode "resize" {
    bindsym --to-code $left resize shrink width 10px
    bindsym --to-code $down resize grow height 10px
    bindsym --to-code $up resize shrink height 10px
    bindsym --to-code $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym i mode "default"
    bindsym Escape mode "normal"
}

bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

bindsym $mod+Print exec grim
bindsym Print exec grim - | wl-copy
bindsym $mod+Shift+Print exec grim -g "$(slurp)"
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy

bar {
    position top
    height 22
    status_command ~/.config/sway/status.sh
    colors {
        statusline #ffffff
        background #000000
        focused_workspace  #ffffff #000000 #ffffff 
        inactive_workspace #000000 #000000 #ffffff
        urgent_workspace   #FF0000 #FF0000 #ffffff
    }
}

include /etc/sway/config.d/*
